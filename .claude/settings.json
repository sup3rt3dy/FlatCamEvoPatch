{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git describe *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git worktree list)",
      "Bash(git check-ignore *)",
      "Bash(git config --get *)",
      "Bash(git config --list)",
      "Bash(git archive *)",
      "Bash(git shortlog *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status)",
      "Bash(gh pr checks *)",
      "Bash(gh repo view)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh auth status)",
      "Bash(gh api -X GET *)",
      "Bash(gh --version)",

      "Bash(python -c *)",
      "Bash(python - *)",
      "Bash(python --version)",
      "Bash(python -V)",
      "Bash(python -X importtime *)",
      "Bash(python -m py_compile *)",
      "Bash(python -m json.tool *)",
      "Bash(python -m pip list)",
      "Bash(python -m pip list *)",
      "Bash(python -m pip show *)",
      "Bash(python -m pip --version)",

      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)"
    ]
  }
}
